# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://somtam:yourpassword@localhost:5432/somtamthai"

# Docker Compose only (DB_PASSWORD is used to build DATABASE_URL inside compose)
DB_PASSWORD="yourpassword"

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET="replace-with-64-char-random-hex"
JWT_EXPIRY="7d"

# ─── MsgOwl SMS Gateway ────────────────────────────────────────────────────────
# Get these from your MsgOwl account dashboard
MSGOWL_API_URL="https://api.msgowl.com/v1/messages"
MSGOWL_API_KEY="your-msgowl-api-key"

# ─── Admin seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@somtamthai.mv"
ADMIN_PASSWORD="change-this-strong-password"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
